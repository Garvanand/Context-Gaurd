# ContextGuard Backend Configuration
APP_NAME=ContextGuard
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Inference Engines
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:3b
VLM_TIMEOUT_SECONDS=15

# ML Models
PHISHING_MODEL_PATH=artifacts/models/xgboost_phishing_v1.json
PHISHING_FEATURE_EXTRACTOR_PATH=artifacts/models/url_features_v1.json

# Policy Engine Parameters
LAMBDA_REVERSIBILITY=0.75
STOP_THRESHOLD=0.65
ASK_THRESHOLD=0.35
MIN_CONFIDENCE_THRESHOLD=0.70

# Privacy & Logging
STORAGE_MODE=memory_only
LOG_LEVEL=INFO
NETWORK_AUDIT_ENABLED=true
ALLOW_RAW_EVAL_MODE=false
