# =============================================================================
# CONTEXTGUARD SYSTEM ENVIRONMENT CONFIGURATION
# =============================================================================

# System Profile: LOCAL_LAN_DEMO | REMOTE_SERVER
CONTEXTGUARD_PROFILE=LOCAL_LAN_DEMO

# Core Service Configuration
APP_NAME=ContextGuard
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Network Host Binding
# For LOCAL_LAN_DEMO: Bind to 0.0.0.0 to permit physical LAN device and emulator access
# For physical phone, configure laptop LAN IPv4 (e.g., 192.168.1.50) in mobile settings
# For standard Android emulator, use 10.0.2.2 in mobile settings
HOST=0.0.0.0
PORT=8000

# Relay & Real-Time Sync Configuration
RELAY_DB_PATH=data/relay.db
RELAY_PAIRING_CODE_EXPIRY_SECONDS=300
RELAY_DEVICE_OFFLINE_TIMEOUT_SECONDS=30
RELAY_MAX_MESSAGE_SIZE_BYTES=65536

# CORS Permitted Origins
# In production, restrict explicitly to dashboard domain (e.g., https://supervisor.contextguard.org)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","*"]

# Machine Learning & Multimodal Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:3b
VLM_TIMEOUT_SECONDS=15
PHISHING_MODEL_PATH=ml/artifacts/url_risk_model.joblib
PHISHING_FEATURE_EXTRACTOR_PATH=ml/artifacts/url_model_metadata.json

# Safety & Privacy Policy Thresholds
STORAGE_MODE=memory_only
ALLOW_RAW_EVAL_MODE=False
NETWORK_AUDIT_ENABLED=True
LAMBDA_REVERSIBILITY=0.75
STOP_THRESHOLD=0.65
ASK_THRESHOLD=0.35
MIN_CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO
